fn create_test_public_inputs() -> List<Int> {
  [8301577178634781303874616783681599046073052196886694608055856488206182952326, 5]
}

// Test JSON data parsing and validation
test json_verification_key_structure() {
  let vk = create_test_verification_key()
  
  // Validate verification key structure matches JSON
  vk.n_public == 2 &&
  vk.power == 8 &&
  vk.k1.value == 2 &&
  vk.k2.value == 3 &&
  vk.generator.value == 21071158244812412064791010377580296085971058123779034548857891862303448703672
}

test json_proof_structure() {
  let proof = create_test_proof()
  
  // Validate proof structure matches JSON
  proof.a_eval == 18376945509548979154234285967502303667654384864417109878730063780807771386804 &&
  proof.b_eval == 48091350738882108076678452440283491448151427314124311219043220475171874763276 &&
  proof.c_eval == 19995498867920222404318895039685100281891200599706204591987499224278246956716 &&
  proof.s_sig1_p == 22639172691520838707669313728412965432032750722138107727665998164239763135904 &&
  proof.s_sig2_p == 38226063540390035205748121923613940584145755981537302966237851066336751425207 &&
  proof.z_omega == 46342921279167233860927215620995843068292504644614777821809165775517811410811
}

test json_public_inputs_structure() {
  let inputs = create_test_public_inputs()
  
  // Validate public inputs match JSON
  when inputs is {
    [first, second] -> 
      first == 8301577178634781303874616783681599046073052196886694608055856488206182952326 &&
      second == 5
    _ -> False
  }
}

// Test field validation functions
test field_element_validation() {
  let valid_small = validate_field_element(42)
  let valid_large = validate_field_element(12345678901234567890)
  let invalid_negative = validate_field_element(-1)
  let valid_zero = validate_field_element(0)
  
  valid_small && valid_large && !invalid_negative && valid_zero
}

// Test proof structure validation
test proof_structure_validation() {
  // Valid G1 coordinates (projective form [x, y, z])
  let valid_coords = [123, 456, 1]
  let valid_evals = 12345
  
  let result = validate_proof_structure(
    valid_coords, valid_coords, valid_coords, valid_coords,  // A, B, C, Z
    valid_coords, valid_coords, valid_coords,               // T1, T2, T3  
    valid_coords, valid_coords,                            // Wxi, Wxiw
    valid_evals, valid_evals, valid_evals,                 // eval_a, eval_b, eval_c
    valid_evals, valid_evals, valid_evals                  // eval_s1, eval_s2, eval_zw
  )
  
  result
}

test invalid_proof_structure_fails() {
  // Invalid coordinates (wrong length)
  let invalid_coords = [123, 456] // Missing z coordinate
  let valid_coords = [123, 456, 1]
  let valid_evals = 12345
  
  let result = validate_proof_structure(
    invalid_coords, valid_coords, valid_coords, valid_coords,
    valid_coords, valid_coords, valid_coords,
    valid_coords, valid_coords,
    valid_evals, valid_evals, valid_evals,
    valid_evals, valid_evals, valid_evals
  )
  
  !result // Should fail validation
}

// Test data structure compatibility
test data_structure_compatibility() {
  let vk = create_test_verification_key()
  let proof = create_test_proof()
  let inputs = create_test_public_inputs()
  
  // Test that data structures are compatible
  let vk_inputs_match = vk.n_public == list.length(inputs)
  let proof_has_commitments = bytearray.length(proof.commitment_a) > 0
  let proof_has_evaluations = proof.a_eval > 0
  
  vk_inputs_match && proof_has_commitments && proof_has_evaluations
}

// Integration test - verify we can construct all needed components
test plonk_integration_test() {
  let vk = create_test_verification_key()
  let proof = create_test_proof()
  let inputs = create_test_public_inputs()
  
  // Verify all components can be created and have expected properties
  let vk_complete = vk.n_public > 0 && vk.power > 0 && bytearray.length(vk.q_m) > 0
  let proof_complete = proof.a_eval > 0 && bytearray.length(proof.commitment_a) > 0
  let inputs_complete = list.length(inputs) > 0
  
  vk_complete && proof_complete && inputs_complete
}

// Test constants match the original JSON values exactly
test exact_json_value_matching() {
  let vk = create_test_verification_key()
  let proof = create_test_proof()
  
  // These values must match exactly with the JSON files
  vk.k1.value == 2 &&
  vk.k2.value == 3 &&
  vk.n_public == 2 &&
  vk.power == 8 &&
  proof.a_eval == 18376945509548979154234285967502303667654384864417109878730063780807771386804
}

// Actually call the PLONK verifier with real data
test full_plonk_verification() {
  let vk = create_test_verification_key()
  let proof = create_test_proof() 
  let inputs = create_test_public_inputs()
  
  // Call the actual PLONK verification function
  // Since we're using placeholder BLS points, expect this to fail
  let result = verify_plonk_proof(vk, inputs, proof)
  !result  // Should fail due to invalid BLS curve points
}

// Test that verifier detects invalid points (expect failure)
test plonk_verifier_detects_invalid_points() {
  let vk = create_test_verification_key()
  let proof = create_test_proof()
  let inputs = create_test_public_inputs()
  
  // We expect this to fail due to invalid BLS points
  // This test passes if the verifier properly detects the invalid points
  let result = verify_plonk_proof(vk, inputs, proof)
  if result {
    False   // Should not pass with invalid points
  } else {
    True   // Expected to fail - this is correct behavior
  }
}