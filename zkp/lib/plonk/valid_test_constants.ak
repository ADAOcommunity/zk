// Valid BLS12-381 test constants for PLONK verification
// These points are generated by scalar multiplication of generators to ensure validity
use common/common.{Point, G1Point, G2Point, g1_compress, g2_compress, g1_generator, g2_generator, g1_mul, g2_mul, bls12_381_prime}
use plonk/plonk_types.{PreInputs, Proof}
use plonk/bls_utils.{mk_scalar}
use plonk/plonk

// Helper function to create valid points (computed at compile time)
fn make_valid_g1_point(scalar: Int) -> G1Point {
    g1_mul(g1_generator(), scalar % bls12_381_prime)
}

fn make_valid_g2_point(scalar: Int) -> G2Point {
    g2_mul(g2_generator(), scalar % bls12_381_prime)
}

// Verification Key - Valid G1 points for polynomial commitments
pub fn get_valid_qm() -> G1Point { make_valid_g1_point(12345) }
pub fn get_valid_ql() -> G1Point { make_valid_g1_point(23456) }
pub fn get_valid_qr() -> G1Point { make_valid_g1_point(34567) }
pub fn get_valid_qo() -> G1Point { make_valid_g1_point(45678) }
pub fn get_valid_qc() -> G1Point { make_valid_g1_point(56789) }
pub fn get_valid_s1() -> G1Point { make_valid_g1_point(67890) }
pub fn get_valid_s2() -> G1Point { make_valid_g1_point(78901) }
pub fn get_valid_s3() -> G1Point { make_valid_g1_point(89012) }

// Valid G2 point for SRS
pub fn get_valid_x2() -> G2Point { make_valid_g2_point(98765) }

// Proof - Valid G1 commitments 
pub fn get_valid_ca() -> G1Point { make_valid_g1_point(11111) }
pub fn get_valid_cb() -> G1Point { make_valid_g1_point(22222) }
pub fn get_valid_cc() -> G1Point { make_valid_g1_point(33333) }
pub fn get_valid_cz() -> G1Point { make_valid_g1_point(44444) }
pub fn get_valid_t1() -> G1Point { make_valid_g1_point(55555) }
pub fn get_valid_t2() -> G1Point { make_valid_g1_point(66666) }
pub fn get_valid_t3() -> G1Point { make_valid_g1_point(77777) }
pub fn get_valid_wxi() -> G1Point { make_valid_g1_point(88888) }
pub fn get_valid_wxiw() -> G1Point { make_valid_g1_point(99999) }

// Valid PLONK verification key
pub fn get_valid_test_vk() -> PreInputs {
    PreInputs {
        n_public: 2,
        power: 8,
        k1: mk_scalar(2),
        k2: mk_scalar(3), 
        q_m: g1_compress(get_valid_qm()),
        q_l: g1_compress(get_valid_ql()),
        q_r: g1_compress(get_valid_qr()),
        q_o: g1_compress(get_valid_qo()),
        q_c: g1_compress(get_valid_qc()),
        s_sig1: g1_compress(get_valid_s1()),
        s_sig2: g1_compress(get_valid_s2()),
        s_sig3: g1_compress(get_valid_s3()),
        x2: g2_compress(get_valid_x2()),
        generator: mk_scalar(21071158244812412064791010377580296085971058123779034548857891862303448703672),
    }
}

// Valid PLONK proof with proper field elements
pub fn get_valid_test_proof() -> Proof {
    Proof {
        commitment_a: g1_compress(get_valid_ca()),
        commitment_b: g1_compress(get_valid_cb()),
        commitment_c: g1_compress(get_valid_cc()),
        commitment_z: g1_compress(get_valid_cz()),
        t_low: g1_compress(get_valid_t1()),
        t_mid: g1_compress(get_valid_t2()),
        t_high: g1_compress(get_valid_t3()),
        w_omega: g1_compress(get_valid_wxi()),
        w_omega_zeta: g1_compress(get_valid_wxiw()),
        
        // Valid field element evaluations (mod BLS12-381 prime)
        a_eval: 1234567890 % bls12_381_prime,
        b_eval: 2345678901 % bls12_381_prime, 
        c_eval: 3456789012 % bls12_381_prime,
        s_sig1_p: 4567890123 % bls12_381_prime,
        s_sig2_p: 5678901234 % bls12_381_prime,
        z_omega: 6789012345 % bls12_381_prime,
    }
}

// Valid public inputs for the circuit
pub fn get_valid_test_public_inputs() -> List<Int> {
    [
        1234567 % bls12_381_prime,
        7654321 % bls12_381_prime
    ]
}

// Simple test to verify our generated points are valid
test valid_points_are_on_curve() {
    // Test that all our generated points are valid BLS12-381 points
    let vk_points = [get_valid_qm(), get_valid_ql(), get_valid_qr(), get_valid_qo(), get_valid_qc(), get_valid_s1(), get_valid_s2(), get_valid_s3()]
    let proof_points = [get_valid_ca(), get_valid_cb(), get_valid_cc(), get_valid_cz(), get_valid_t1(), get_valid_t2(), get_valid_t3(), get_valid_wxi(), get_valid_wxiw()]
    
    check_points_validity(vk_points) && check_points_validity(proof_points)
}

fn check_points_validity(points: List<G1Point>) -> Bool {
    when points is {
        [] -> True
        [p, ..rest] -> {
            let on_curve = is_point_on_curve(p)
            on_curve && check_points_validity(rest)
        }
    }
}

fn is_point_on_curve(p: G1Point) -> Bool {
    if p.z == 0 {
        True  // Point at infinity is valid
    } else {
        // Check y^2 = x^3 + 4 in projective coordinates
        let y2 = (p.y * p.y) % bls12_381_prime
        let z2 = (p.z * p.z) % bls12_381_prime
        let z4 = (z2 * z2) % bls12_381_prime
        let z6 = (z4 * z2) % bls12_381_prime
        let x3 = ((p.x * p.x) % bls12_381_prime * p.x) % bls12_381_prime
        let rhs = (x3 + (4 * z6) % bls12_381_prime) % bls12_381_prime
        let lhs = (y2 * z4) % bls12_381_prime
        
        lhs == rhs
    }
}

// Test using the valid points with PLONK verification
test plonk_verify_with_valid_generated_points() {
    // Test the PLONK verification with our valid points
    let vk = get_valid_test_vk()
    let proof = get_valid_test_proof()
    let public_inputs = get_valid_test_public_inputs()
    
    let verify_result = plonk.verify_plonk_proof(vk, public_inputs, proof)
    
    // IMPORTANT: Random proof data should FAIL legitimate verification
    // This test should actually FAIL if the PLONK verifier is working correctly
    // We're testing that it doesn't crash with BLS errors, not that it passes verification
    
    // For now, we expect this random proof to be rejected
    !verify_result  // Random/invalid proof should be rejected
}